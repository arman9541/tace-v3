{
  "name": "TACE v3 Python Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  
  // Customizations for VS Code inside Codespaces
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  // Automatically run a quick status check when the container builds
  "postCreateCommand": "python3 --version && echo 'TACE v3 Environment Ready! Run: python3 tace_v3.py'"
}
